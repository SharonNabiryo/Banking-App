# Copy to .env (or export these) before running in production.
SECRET_KEY=change-me-to-a-long-random-string
JWT_SECRET_KEY=change-me-too
# SQLite is used by default. For PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/copperleaf
# Only needed if the React app is hosted on a different domain:
# CORS_ORIGINS=https://copperleaf.example.com
MAX_ACCOUNTS=100
